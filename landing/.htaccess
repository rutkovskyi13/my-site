# Phonics4All: адреси сайту
RewriteEngine On

# Старий домен phonics4all.fun (з www і без) → новий, зі збереженням сторінки
RewriteCond %{HTTP_HOST} ^(www\.)?phonics4all\.fun$ [NC]
RewriteRule ^(.*)$ https://phonics4all.com.ua/$1 [R=301,L]

# www.phonics4all.com.ua → phonics4all.com.ua
RewriteCond %{HTTP_HOST} ^www\.phonics4all\.com\.ua$ [NC]
RewriteRule ^(.*)$ https://phonics4all.com.ua/$1 [R=301,L]

# /index.html → / (і practice/index.html → practice/), щоб в адресі був лише домен
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Кешування в браузері: картинки, відео й шрифти рідко змінюються, сторінки — завжди свіжі
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
